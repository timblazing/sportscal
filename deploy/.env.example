# Neon "Direct connection" string — used for migrations on container start.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon "Pooled connection" string — used for app traffic.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Public origin people use to reach the site.
APP_URL=https://sportscal.site
# Any random string; salts IP hashes in the rate-limit table.
RATE_LIMIT_SALT=change-me
