{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "sportscal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sportscal"
    }
  ],
  // Workers Paid: cap each invocation's CPU (default is 30 s). Normal cache
  // hits use a few ms; cold catalog/schedule normalization needs headroom.
  "limits": {
    "cpu_ms": 200
  },
  // Sampled so an abusive request flood can't exceed included Workers Logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  // Shared normalized-data cache, upstream budget, and public admission
  // control (db/cache/0001_cache.sql).
  "d1_databases": [
    {
      "binding": "SPORTSCAL_CACHE",
      "database_name": "sportscal-cache",
      "database_id": "a163daa9-6dd9-48a0-86af-d7fbbc65289c",
      "migrations_dir": "db/cache"
    }
  ],
  "vars": {
    "APP_URL": "https://sportscal.site"
  }
  // Secrets (DATABASE_URL, DATABASE_URL_POOLED, RATE_LIMIT_SALT) live in the
  // dashboard: Worker → Settings → Variables and Secrets.
}
