{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "sportscal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Serve only through sportscal.site so the zone's rate-limiting rule
  // applies to every request; workers.dev and preview URLs would bypass it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sportscal"
    }
  ],
  // Workers Free: the platform enforces 10 ms CPU and 100k requests/day.
  // Custom `limits` are Paid-only and would make deploys fail.
  // Sampled so an abusive request flood can't exceed included Workers Logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  // Shared normalized-data cache, upstream budget, and public admission
  // control (db/cache/0001_cache.sql).
  // Saved-calendar PostgreSQL (Neon) through Hyperdrive: unlimited queries
  // on Workers Free up to 100k/day, then refused (not billed); caching disabled.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "40b49935761c41a6a7ba32b1751a3212",
      // Local-only placeholder required by `next dev`/build tooling; production
      // uses the Hyperdrive config above. Never put a real credential here.
      "localConnectionString": "postgres://localhost:5432/sportscal"
    }
  ],
  "d1_databases": [
    {
      "binding": "SPORTSCAL_CACHE",
      "database_name": "sportscal-cache",
      "database_id": "a163daa9-6dd9-48a0-86af-d7fbbc65289c",
      "migrations_dir": "db/cache"
    }
  ],
  "vars": {
    "APP_URL": "https://sportscal.site"
  }
  // Secrets (DATABASE_URL, DATABASE_URL_POOLED, RATE_LIMIT_SALT) live in the
  // dashboard: Worker → Settings → Variables and Secrets.
}
