# Direct PostgreSQL connection — used for migrations (and by the app if no pooled URL is set).
# Local default matches docker-compose.yml.
DATABASE_URL=postgres://sportscal:sportscal@localhost:5432/sportscal

# Optional pooled connection for app traffic (Neon: the "-pooler" host).
# DATABASE_URL_POOLED=

# Public origin used for subscription/manage URLs (read at runtime).
APP_URL=http://localhost:3000

# Optional: anonymous create/update rate limit (per IP, fixed window).
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_SECONDS=3600
# RATE_LIMIT_SALT=change-me
