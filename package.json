    "ics": "^3.12.0",
    "lucide-react": "^1.48.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
